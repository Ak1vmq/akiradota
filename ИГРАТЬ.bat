@echo off
chcp 65001 >nul
title ДОТА БАТЯ - Быстрый запуск
echo.
echo  ╔══════════════════════════════════════════╗
echo  ║     🎮 ДОТА БАТЯ - Быстрый запуск       ║
echo  ║                                          ║
echo  ║   Запуск в режиме разработки...          ║
echo  ╚══════════════════════════════════════════╝
echo.

:: Проверяем наличие Node.js
where node >nul 2>nul
if %ERRORLEVEL% NEQ 0 (
    echo  [ОШИБКА] Node.js не найден!
    echo.
    echo  ═══════════════════════════════════════════
    echo  Как установить Node.js:
    echo  ═══════════════════════════════════════════
    echo.
    echo  1. Откройте https://nodejs.org
    echo  2. Скачайте версию LTS (зелёная кнопка)
    echo  3. Установите (всё время жмите "Далее")
    echo  4. Перезапустите этот файл
    echo.
    pause
    exit /b
)

:: Переходим в папку проекта
cd /d "%~dp0"

:: Проверяем есть ли node_modules
if not exist "node_modules\" (
    echo  [INFO] Первый запуск! Устанавливаем зависимости...
    echo  Это займёт 1-3 минуты. Подождите...
    echo.
    call npm install
    if %ERRORLEVEL% NEQ 0 (
        echo  [ОШИБКА] Не удалось установить зависимости!
        echo  Проверьте интернет-соединение и попробуйте снова.
        pause
        exit /b
    )
    echo.
    echo  ✅ Зависимости установлены!
    echo.
)

:: Открываем браузер
start "" cmd /c "timeout /t 3 /nobreak >nul && start http://localhost:3000"

echo  ╔══════════════════════════════════════════╗
echo  ║   ✅ Игра запускается!                   ║
echo  ║   Браузер откроется автоматически.       ║
echo  ║                                          ║
echo  ║   Если не открылся - откройте вручную:   ║
echo  ║   http://localhost:3000                  ║
echo  ║                                          ║
echo  ║   ⚠️  НЕ ЗАКРЫВАЙТЕ ЭТО ОКНО!           ║
echo  ╚══════════════════════════════════════════╝
echo.

:: Запускаем dev сервер
call npm run dev

pause
